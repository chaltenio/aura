{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer ${GITHUB_TOKEN:-${GITHUB_PERSONAL_ACCESS_TOKEN}}" }
    },
    "fly": {
      "type": "stdio",
      "command": "fly",
      "args": ["mcp", "server"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.84", "--headless"]
    }
  }
}
