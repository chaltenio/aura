{
  "name": "haunt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Point your phone at someone in the room and know who they are. Opt-in, on-device face-to-profile for events.",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node test/smoke.mjs",
    "base44": "node scripts/base44.mjs",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "go": "claude \"Start my session: run /start\""
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  }
}
